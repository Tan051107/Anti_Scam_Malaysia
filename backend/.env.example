# AWS credentials and services
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=your_aws_region

# Amazon Bedrock
BEDROCK_MODEL_ID=your_bedrock_model_id
SIMULATOR_MODEL_ID=your_simulator_model_id
COMMUNITY_MODEL_ID=your_community_model_id
ANALYSIS_GUARDRAIL_ID=your_analysis_guardrail_id
ANALYSIS_GUARDRAIL_VERSION=DRAFT
SIMULATOR_GUARDRAIL_ID=your_simulator_guardrail_id
SIMULATOR_GUARDRAIL_VERSION=DRAFT

# Database: choose one option.
# Option 1 (recommended): a direct PostgreSQL URL. This is used by both the
# application and Alembic migrations.
DATABASE_URL=postgresql://user:password@host:5432/database
# Set this only if your database provider requires a CA certificate.
RDS_SSL_CERT=

# Option 2: AWS RDS plus a Secrets Manager secret. Leave DATABASE_URL blank.
# The secret must contain a JSON "password" value.
RDS_HOST=your_database_host
RDS_PORT=5432
RDS_DB=your_database_name
RDS_USER=your_database_user
RDS_SECRET_ARN=your_aws_secrets_manager_arn

# Authentication
# Generate a long random value; use the same value on every backend instance.
JWT_SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Browser access
# Comma-separated frontend origins; do not use * when credentials are enabled.
CORS_ORIGINS=http://localhost:5173

# Community image storage
S3_BUCKET_NAME=your_s3_bucket_name
